# Copy to .env and adjust. All settings are optional; defaults are in src/evs_cadsr_mcp/core/config.py
ECM_PROFILE=evs-only
ECM_EVS_BASE_URL=https://api-evsrest.nci.nih.gov/api/v1
# ECM_RELEASE_PIN=26.09d
ECM_HTTP_HOST=127.0.0.1                # any non-loopback address needs ECM_AUTH_MODE=jwt (or ECM_ALLOW_UNAUTHENTICATED=true)
ECM_HTTP_PORT=8000
ECM_BUDGET_MAX_REQUESTS=50
ECM_HTTP_MAX_RETRIES=3
ECM_HTTP_MAX_CONCURRENCY=8
# ECM_LICENSE_KEY=            # X-EVSRESTAPI-License-Key, only sent for gated targets
ECM_LICENSE_GATED_TERMINOLOGIES=["meddra","mdr"]
# ICD-O-3.1 mapping files for map_map_icdo_to_ncit, downloaded from EVS and re-checked daily
# ECM_ICDO_CACHE_DIR=~/.cache/evs-cadsr-mcp/icdo
# ECM_ICDO_SYNC_INTERVAL_S=86400    # 0: no automatic downloads; use `evs-cadsr-mcp icdo sync`
# ECM_ICDO_SOURCE_URL=https://evs.nci.nih.gov/ftp1/NCI_Thesaurus/Mappings/ICD-O-3_Mappings/
ECM_LOG_LEVEL=INFO
ECM_LOG_JSON=false

# caDSR (profiles cadsr-only / unified)
# ECM_CADSR_BASE_URL=https://cadsrapi.cancer.gov
# Basic auth for LOV API and CDE Match 2.0 (from the secrets manager in production). Either both of:
# ECM_CADSR_USERNAME=
# ECM_CADSR_PASSWORD=
# or the combined form (not both):
# ECM_CADSR_CREDENTIAL=user:password
# ECM_CADSR_AI_MATCH_URL=                 # CDE AI Match API base (internal upstream)
# ECM_CADSR_AI_MATCH_VARIANT=
# ECM_CADSR_EXPORT_LISTING_URL=
ECM_CADSR_READ_TIMEOUT_S=45

# Platform (remote deployments; see docs/deployment.md)
# ECM_AUTH_MODE=jwt
# ECM_AUTH_JWKS_URI=https://idp.example.nih.gov/.well-known/jwks.json
# ECM_AUTH_ISSUER=https://idp.example.nih.gov/
# ECM_AUTH_AUDIENCE=https://evs-cadsr-mcp.example.nih.gov
# ECM_SCOPE_ENFORCEMENT=true          # on by default with jwt; issuer and audience are required
# ECM_ALLOW_UNAUTHENTICATED=false      # true only behind a trusted, authenticating gateway
# ECM_ADMIN_TOKEN=                     # Bearer token for /metrics and detailed /readyz off loopback
ECM_TRUSTED_HOSTS=["localhost","127.0.0.1"]
ECM_RATE_LIMIT_PER_MINUTE=0            # 0 disables; e.g. 300 with burst 60 in production
ECM_RATE_LIMIT_BURST=20
# ECM_AUDIT_SINK=stdout                # stdout | stderr | /var/log/ecm/audit.jsonl
# ECM_CACHE_URL=rediss://:<password>@cache.internal:6379/0   # shared cache tier; memory:// for single-node tests
ECM_METRICS_ENABLED=true
